# Normalize line endings to LF (except for Windows-only files)
* text=auto eol=lf

# Explicit LF for known text types
*.java       text eol=lf
*.properties text eol=lf
*.xml        text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.sql        text eol=lf
*.sh         text eol=lf

# Shell scripts must have LF
*.bat        text eol=crlf
*.cmd        text eol=crlf
